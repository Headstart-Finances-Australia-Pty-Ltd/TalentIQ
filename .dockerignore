# ── Sensitive / PII data — never bake these into the image ─────────
# LinkedIn session state (cookies/auth tokens) and scraped profile HTML.
# If your app needs these at runtime, mount them as a Northflank volume
# or load credentials from Northflank secrets instead.
backend/data/linkedin/
backend/data/temp/

# ── VCS / editor ─────────────────────────────────────────────────
.git/
.gitignore
.vscode/
.idea/

# ── Env files (inject via Northflank env vars instead) ──────────────
.env
.env.*
*.env

# ── Python ───────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/
.venv/
venv/

# ── Node / frontend build artifacts (rebuilt in Stage 1) ───────────
frontend/node_modules/
frontend/dist/

# ── Misc ─────────────────────────────────────────────────────────
*.log
.DS_Store
README.md
app.cmd
